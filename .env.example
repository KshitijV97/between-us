# Chat Analyzer configuration — copy to .env and adjust. Every variable is optional
# in the default `local` profile. Authoritative reference with per-profile defaults:
# docs/07-deployment.md §8. Variables marked (Mx) take effect from that milestone.
#
# Never commit a real .env: it is git-ignored on purpose.

# --- Profile and runtime ------------------------------------------------------
# local | local-full | cloud-free | cloud-free-container (sets safe defaults below)
CA_PROFILE=local
# local (single implicit user) | hosted (multi-tenant). Default comes from the profile.
# CA_MODE=local
# local | staging | production (telemetry attribute deployment.environment.name)
# CA_ENV=local

# --- HTTP ---------------------------------------------------------------------
# Listen address. Local binds loopback only. PORT (set by Vercel/Render/Koyeb)
# replaces just the port when CA_HTTP_ADDR is unset.
# CA_HTTP_ADDR=127.0.0.1:7420
# External URL used in emails and OAuth redirects.
# CA_PUBLIC_BASE_URL=http://127.0.0.1:7420
# Total export size cap in bytes; uploads arrive in <= 4 MB parts (M1, FR-ING-016).
# CA_UPLOAD_MAX_BYTES=524288000
# Per-tenant request rate limit (M5).
# CA_RATE_LIMIT_RPS=10

# --- Logging ------------------------------------------------------------------
# debug | info | warn | error
CA_LOG_LEVEL=info
# text (local) | json (hosted)
# CA_LOG_FORMAT=text

# --- Database (M1) ------------------------------------------------------------
# sqlite | postgres (cloud profiles require postgres)
# CA_DB_DRIVER=sqlite
# CA_DB_DSN=file:chatanalyzer.db
# Owner connection used only by `chatanalyzer migrate` (postgres).
# CA_DB_MIGRATE_DSN=
# CA_DB_MAX_CONNS=10
# CA_MIGRATE_ON_START=true
# Free-tier DB size, used by the DbSizeNearLimit alert (e.g. 524288000 for 500 MB).
# CA_DB_SIZE_LIMIT_BYTES=
# Keep original export files (off by default, FR-ING-014).
# CA_KEEP_RAW_EXPORTS=false

# --- Jobs (M2/M5) -------------------------------------------------------------
# inprocess | pump (serverless)
# CA_JOBS_MODE=inprocess
# CA_JOBS_CONCURRENCY=2
# CA_JOBS_PER_TENANT=2
# CA_PUMP_BUDGET_MS=20000
# CA_PUMP_SECRET=

# --- Auth (M5) ----------------------------------------------------------------
# local | supabase | oidc
# CA_AUTH_PROVIDER=local
# CA_SESSION_SECRET=
# CA_SUPABASE_URL=
# CA_SUPABASE_JWKS_URL=
# CA_OIDC_ISSUER=
# CA_OIDC_CLIENT_ID=
# CA_OIDC_CLIENT_SECRET=
# CA_CORS_ORIGINS=
# Key-encryption key for per-tenant envelope encryption (P2).
# CA_MASTER_KEY=

# --- Quotas (M5) --------------------------------------------------------------
# CA_QUOTA_CHATS=5
# CA_QUOTA_MESSAGES=500000
# CA_QUOTA_LLM_TOKENS_MONTH=2000000

# --- AI (M4) ------------------------------------------------------------------
# none | ollama | openai-compatible | anthropic
# CA_LLM_PROVIDER=none
# CA_LLM_BASE_URL=http://127.0.0.1:11434
# CA_LLM_API_KEY=
# CA_LLM_MODEL=
# CA_LLM_FAST_MODEL=
# CA_EMBED_PROVIDER=none
# CA_EMBED_MODEL=
# CA_LLM_TIMEOUT=120s
# CA_LLM_MAX_CONCURRENCY=2
# CA_LLM_REDACT_PII=true
# CA_LLM_DAILY_BUDGET_USD=0
# Must be true to allow providers whose free tier trains on inputs (PRV-003).
# CA_LLM_ALLOW_UNPAID_TRAINING_PROVIDERS=false
# CA_LLM_DEBUG_CAPTURE=false
# CA_PROMPT_DIR=
# CA_LEXICON_DIR=

# --- Privacy ------------------------------------------------------------------
# Hosts the process may call (PRV-001). Empty = loopback only in local mode.
# CA_EGRESS_ALLOWLIST=

# --- Observability (M6) -------------------------------------------------------
# CA_OTEL_ENABLED=false
# CA_OTEL_SAMPLE_RATIO=0.2
# CA_TELEMETRY_SALT=
# CA_METRICS_ENABLED=false
# CA_METRICS_TOKEN=
# CA_METRICS_ADDR=
# CA_PPROF_ENABLED=false
# Standard OpenTelemetry exporter variables (not CA_-prefixed, per the OTel spec).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# --- Notifications (M6) -------------------------------------------------------
# Comma list: email, push (ntfy), telegram, sms, log
# CA_NOTIFY_CHANNELS=log
# smtp | api
# CA_EMAIL_TRANSPORT=smtp
# resend | brevo | mailjet (when CA_EMAIL_TRANSPORT=api)
# CA_EMAIL_API_PROVIDER=
# CA_EMAIL_API_KEY=
# CA_SMTP_HOST=localhost
# CA_SMTP_PORT=1025
# CA_SMTP_USERNAME=
# CA_SMTP_PASSWORD=
# starttls | implicit | none (dev only)
# CA_SMTP_TLS=starttls
# CA_EMAIL_FROM=
# CA_EMAIL_REPLY_TO=
# CA_EMAIL_DAILY_LIMIT=
# CA_NTFY_URL=
# CA_NTFY_TOKEN=
# CA_TELEGRAM_BOT_TOKEN=
# CA_SMS_GATEWAY_URL=
# CA_SMS_GATEWAY_USERNAME=
# CA_SMS_GATEWAY_PASSWORD=
