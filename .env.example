# Between Us configuration — copy to .env and adjust. Every variable is optional
# in the default `local` profile. Authoritative reference with per-profile defaults:
# docs/07-deployment.md §8. Variables marked (Mx) take effect from that milestone.
#
# Never commit a real .env: it is git-ignored on purpose.

# --- Profile and runtime ------------------------------------------------------
# local | local-full | cloud-free | cloud-free-container (sets safe defaults below)
BU_PROFILE=local
# local (single implicit user) | hosted (multi-tenant). Default comes from the profile.
# BU_MODE=local
# local | staging | production (telemetry attribute deployment.environment.name)
# BU_ENV=local

# --- HTTP ---------------------------------------------------------------------
# Listen address. Local binds loopback only. PORT (set by Vercel/Render/Koyeb)
# replaces just the port when BU_HTTP_ADDR is unset.
# BU_HTTP_ADDR=127.0.0.1:7420
# External URL used in emails and OAuth redirects.
# BU_PUBLIC_BASE_URL=http://127.0.0.1:7420
# Total export size cap in bytes; uploads arrive in <= 4 MB parts (M1, FR-ING-016).
# BU_UPLOAD_MAX_BYTES=524288000
# Per-tenant request rate limit (M5).
# BU_RATE_LIMIT_RPS=10

# --- Logging ------------------------------------------------------------------
# debug | info | warn | error
BU_LOG_LEVEL=info
# text (local) | json (hosted)
# BU_LOG_FORMAT=text

# --- Database (M1) ------------------------------------------------------------
# Local state directory (SQLite file). Default: the OS per-user app-data folder.
# BU_DATA_DIR=
# sqlite | postgres (cloud profiles require postgres)
# BU_DB_DRIVER=sqlite
# Default for sqlite: file:$BU_DATA_DIR/betweenus.db
# BU_DB_DSN=
# Owner connection used only by `betweenus migrate` (postgres).
# BU_DB_MIGRATE_DSN=
# BU_DB_MAX_CONNS=10
# BU_MIGRATE_ON_START=true
# Free-tier DB size, used by the DbSizeNearLimit alert (e.g. 524288000 for 500 MB).
# BU_DB_SIZE_LIMIT_BYTES=
# Keep original export files (off by default, FR-ING-014).
# BU_KEEP_RAW_EXPORTS=false

# --- Jobs (M2/M5) -------------------------------------------------------------
# inprocess | pump (serverless)
# BU_JOBS_MODE=inprocess
# BU_JOBS_CONCURRENCY=2
# BU_JOBS_PER_TENANT=2
# BU_PUMP_BUDGET_MS=20000
# BU_PUMP_SECRET=

# --- Auth (M5) ----------------------------------------------------------------
# local | supabase | oidc
# BU_AUTH_PROVIDER=local
# BU_SESSION_SECRET=
# BU_SUPABASE_URL=
# BU_SUPABASE_JWKS_URL=
# BU_OIDC_ISSUER=
# BU_OIDC_CLIENT_ID=
# BU_OIDC_CLIENT_SECRET=
# BU_CORS_ORIGINS=
# Key-encryption key for per-tenant envelope encryption (P2).
# BU_MASTER_KEY=

# --- Quotas (M5) --------------------------------------------------------------
# BU_QUOTA_CHATS=5
# BU_QUOTA_MESSAGES=500000
# BU_QUOTA_LLM_TOKENS_MONTH=2000000

# --- AI (M4) ------------------------------------------------------------------
# none | ollama | openai-compatible | anthropic
# BU_LLM_PROVIDER=none
# BU_LLM_BASE_URL=http://127.0.0.1:11434
# BU_LLM_API_KEY=
# BU_LLM_MODEL=
# BU_LLM_FAST_MODEL=
# BU_EMBED_PROVIDER=none
# BU_EMBED_MODEL=
# BU_LLM_TIMEOUT=120s
# BU_LLM_MAX_CONCURRENCY=2
# BU_LLM_REDACT_PII=true
# BU_LLM_DAILY_BUDGET_USD=0
# Must be true to allow providers whose free tier trains on inputs (PRV-003).
# BU_LLM_ALLOW_UNPAID_TRAINING_PROVIDERS=false
# BU_LLM_DEBUG_CAPTURE=false
# BU_PROMPT_DIR=
# BU_LEXICON_DIR=

# --- Privacy ------------------------------------------------------------------
# Hosts the process may call (PRV-001). Empty = loopback only in local mode.
# BU_EGRESS_ALLOWLIST=

# --- Observability (M6) -------------------------------------------------------
# BU_OTEL_ENABLED=false
# BU_OTEL_SAMPLE_RATIO=0.2
# BU_TELEMETRY_SALT=
# BU_METRICS_ENABLED=false
# BU_METRICS_TOKEN=
# BU_METRICS_ADDR=
# BU_PPROF_ENABLED=false
# Standard OpenTelemetry exporter variables (not CA_-prefixed, per the OTel spec).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_EXPORTER_OTLP_HEADERS=
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# --- Notifications (M6) -------------------------------------------------------
# Comma list: email, push (ntfy), telegram, sms, log
# BU_NOTIFY_CHANNELS=log
# smtp | api
# BU_EMAIL_TRANSPORT=smtp
# resend | brevo | mailjet (when BU_EMAIL_TRANSPORT=api)
# BU_EMAIL_API_PROVIDER=
# BU_EMAIL_API_KEY=
# BU_SMTP_HOST=localhost
# BU_SMTP_PORT=1025
# BU_SMTP_USERNAME=
# BU_SMTP_PASSWORD=
# starttls | implicit | none (dev only)
# BU_SMTP_TLS=starttls
# BU_EMAIL_FROM=
# BU_EMAIL_REPLY_TO=
# BU_EMAIL_DAILY_LIMIT=
# BU_NTFY_URL=
# BU_NTFY_TOKEN=
# BU_TELEGRAM_BOT_TOKEN=
# BU_SMS_GATEWAY_URL=
# BU_SMS_GATEWAY_USERNAME=
# BU_SMS_GATEWAY_PASSWORD=
